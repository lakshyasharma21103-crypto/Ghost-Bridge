NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5174
MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/ghost-bridge
MONGODB_DB_NAME=ghost_bridge
MONGODB_AUTH_SOURCE=admin
JWT_SECRET=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=optional-32-byte-base64-key
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
# Optional JSON key ring for decrypting historical versions. Keep old keys until usage is zero.
# CREDENTIAL_ENCRYPTION_KEYS={"v1":"old-32-byte-key","v2":"current-32-byte-key"}
REDIS_URL=
COOKIE_SECURE=false
RUNTIME_REQUEST_TIMEOUT_MS=15000
RUNTIME_INVOCATION_TIMEOUT_MS=330000
INVOCATION_STUCK_SCAN_LIMIT=100
INVOCATION_STUCK_GRACE_MS=60000
INVOCATION_FINALIZATION_GRACE_MS=30000
OPS_ALERT_AMBIGUOUS_OUTCOME_COUNT=3
OPS_ALERT_FINALIZATION_STALL_COUNT=2
OPS_ALERT_RECOVERY_GROWTH_COUNT=5
OPS_ALERT_LEASE_EXPIRY_COUNT=3
OPS_ALERT_RETRY_DENIAL_COUNT=3
OPS_ALERT_STUCK_INVOCATION_COUNT=3
RUNTIME_RETRY_MAX_ATTEMPTS=2
RUNTIME_RETRY_BASE_DELAY_MS=1000
RUNTIME_RETRY_MAX_DELAY_MS=10000
RUNTIME_RETRY_JITTER_PERCENT=20
RUNTIME_EXECUTION_LEASE_MS=360000
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_FAILURE_WINDOW_MS=60000
CIRCUIT_OPEN_DURATION_MS=30000
CIRCUIT_HALF_OPEN_MAX_PROBES=1
CIRCUIT_SUCCESS_THRESHOLD_TO_CLOSE=1
RUNTIME_MAX_CONCURRENT_PER_CONNECTION=3
RUNTIME_MAX_CONCURRENT_PER_WORKSPACE=20
SHUTDOWN_DRAIN_TIMEOUT_MS=30000
DURABLE_WORKER_ENABLED=true
DURABLE_WORKER_POLL_INTERVAL_MS=1000
DURABLE_WORKER_BATCH_SIZE=5
DURABLE_WORKER_CONCURRENCY=3
DURABLE_WORK_LEASE_MS=360000
DURABLE_WORK_HEARTBEAT_MS=30000
DURABLE_WORK_ABANDONED_GRACE_MS=60000
DURABLE_WORK_MAX_ATTEMPTS=2
DURABLE_WORK_DEAD_LETTER_AFTER_ATTEMPTS=3
DURABLE_WORK_SHUTDOWN_DRAIN_MS=30000
EXTERNAL_TEST_AGENT_BASE_URL=https://external-research-agent.onrender.com
EXTERNAL_TEST_AGENT_RUNTIME_TOKEN=replace-with-the-external-agent-runtime-token
ALLOW_PRIVATE_RUNTIME_URLS_IN_DEV=false
OPS_ALERT_FAILURE_RATE_MIN_INVOCATIONS=10
OPS_ALERT_FAILURE_RATE_PERCENT=25
OPS_ALERT_P95_LATENCY_MS=300000
OPS_ALERT_PROVIDER_ERROR_COUNT=5
OPS_ALERT_INSTALL_FAILURE_PERCENT=25
OPS_ALERT_AUTH_FAILURE_COUNT=3
