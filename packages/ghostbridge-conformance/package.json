{
  "name": "@ghostbridge/conformance",
  "version": "0.1.0-draft",
  "private": true,
  "description": "Deterministic local conformance foundation for Ghost Bridge Native Levels 1-3.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "ghostbridge-conformance": "src/cli.js"
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/cli.js",
    "typecheck": "node --check src/index.js && node --check src/cli.js",
    "lint": "node --check src/index.js && node --check src/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "@ghostbridge/protocol-core": "0.1.0-draft",
    "@ghostbridge/native-client": "0.1.0-draft",
    "@ghostbridge/trust": "0.1.0-draft"
  },
  "license": "UNLICENSED"
}
