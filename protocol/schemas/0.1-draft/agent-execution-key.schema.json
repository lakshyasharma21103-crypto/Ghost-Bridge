{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/agent-execution-key.schema.json",
  "title": "Agent execution-key authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["kid", "thumbprint", "purposes", "notBefore", "expiresAt", "status"],
  "properties": {
    "kid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$" },
    "thumbprint": { "type": "string", "minLength": 32, "maxLength": 100 },
    "purposes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["execution_receipt_signing", "request_signing"] } },
    "notBefore": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["active", "suspended", "revoked", "expired"] },
    "runtimeInstanceScope": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
