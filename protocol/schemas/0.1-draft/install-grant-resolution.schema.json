{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/install-grant-resolution.schema.json",
  "title": "Install Grant resolution",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "grantReference", "passport", "capabilities", "connectionOffer", "issuerVerification", "requestedScope", "restrictions", "expiresAt", "redemptionState"],
  "properties": {
    "protocolVersion": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/protocolVersion" },
    "grantReference": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "passport": { "type": "object" },
    "capabilities": { "type": "array", "maxItems": 256, "items": { "type": "object" } },
    "connectionOffer": { "type": "object" },
    "issuerVerification": { "type": "object", "additionalProperties": true },
    "requestedScope": { "type": "object", "required": ["organizationScope"], "properties": { "organizationScope": { "type": "string" }, "workspaceScope": { "type": "string" } }, "additionalProperties": false },
    "restrictions": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "redemptionState": { "enum": ["available", "redeemed", "expired", "revoked"] },
    "issuer": { "type": "string", "format": "uri", "maxLength": 500 },
    "agentId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "passportId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "passportVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "capabilityManifest": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/capability-manifest.schema.json" },
    "capabilityManifestDigest": { "type": "string", "minLength": 32, "maxLength": 100 },
    "audience": { "type": "string", "minLength": 1, "maxLength": 500 },
    "organizationScope": { "type": "string", "minLength": 1, "maxLength": 200 },
    "workspaceScope": { "type": "string", "minLength": 1, "maxLength": 200 },
    "requestedCapabilitySet": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "connectionOfferDigest": { "type": "string", "minLength": 32, "maxLength": 100 },
    "issuedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "messageId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "oneTimeRedemptionState": { "enum": ["available", "redeemed", "expired", "revoked"] },
    "trustProfileVersion": { "const": "ghostbridge-trust/0.1-draft" },
    "proof": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/proof.schema.json" }
  }
}
