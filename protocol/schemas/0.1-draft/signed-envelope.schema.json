{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/signed-envelope.schema.json",
  "title": "Ghost Bridge signed envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelopeVersion", "contentType", "trustProfileVersion", "issuer", "subject", "audience", "issuedAt", "expiresAt", "messageId", "payloadDigest", "payload", "proof"],
  "properties": {
    "envelopeVersion": { "const": "0.1-draft" },
    "contentType": { "type": "string", "minLength": 1, "maxLength": 200 },
    "trustProfileVersion": { "const": "ghostbridge-trust/0.1-draft" },
    "issuer": { "type": "string", "format": "uri", "maxLength": 500 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
    "audience": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }] },
    "issuedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "messageId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 500 },
    "payloadDigest": { "type": "string", "minLength": 32, "maxLength": 100 },
    "payload": { "type": ["object", "array"] },
    "proof": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/proof.schema.json" }
  }
}
