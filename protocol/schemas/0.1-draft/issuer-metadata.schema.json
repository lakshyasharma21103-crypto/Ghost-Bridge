{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/issuer-metadata.schema.json",
  "title": "Ghost Bridge issuer metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "trustProfileVersion", "metadataVersion", "issuerId", "displayName", "status", "issuedAt", "updatedAt", "expiresAt", "supportedProtocolVersions", "supportedTrustProfiles", "supportedProofProfiles", "supportedAlgorithms", "jwksUri", "revocationSetUri", "rootKeyThumbprints", "operationalKeyPolicy", "agentKeyPolicy", "metadataSequence", "extensions", "proof"],
  "properties": {
    "protocolVersion": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/protocolVersion" },
    "trustProfileVersion": { "const": "ghostbridge-trust/0.1-draft" },
    "metadataVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "issuerId": { "type": "string", "format": "uri", "minLength": 8, "maxLength": 500, "pattern": "^https?://" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["active", "restricted", "suspended", "compromised", "retired"] },
    "issuedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "supportedProtocolVersions": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "supportedTrustProfiles": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "supportedProofProfiles": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "supportedAlgorithms": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "const": "EdDSA" } },
    "jwksUri": { "type": "string", "format": "uri", "maxLength": 500, "pattern": "^https?://" },
    "revocationSetUri": { "type": "string", "format": "uri", "maxLength": 500, "pattern": "^https?://" },
    "securityPolicyUri": { "type": "string", "format": "uri", "maxLength": 500, "pattern": "^https?://" },
    "privacyPolicyUri": { "type": "string", "format": "uri", "maxLength": 500, "pattern": "^https?://" },
    "termsUri": { "type": "string", "format": "uri", "maxLength": 500, "pattern": "^https?://" },
    "documentationUri": { "type": "string", "format": "uri", "maxLength": 500, "pattern": "^https?://" },
    "rootKeyThumbprints": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 32, "maxLength": 100 } },
    "operationalKeyPolicy": { "type": "object", "maxProperties": 16, "additionalProperties": true },
    "agentKeyPolicy": { "type": "object", "maxProperties": 16, "additionalProperties": true },
    "metadataSequence": { "type": "integer", "minimum": 1 },
    "extensions": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/extensions" },
    "proof": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/proof.schema.json" }
  }
}
