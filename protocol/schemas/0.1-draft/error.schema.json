{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/error.schema.json",
  "title": "Ghost Bridge protocol error",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "messageType", "errorCode", "safeMessage", "retryable"],
  "properties": {
    "protocolVersion": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/protocolVersion" },
    "messageType": { "const": "protocol.error" },
    "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,99}$" },
    "safeMessage": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retryable": { "type": "boolean" },
    "retryAfterMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "requestId": { "type": "string", "maxLength": 200 },
    "traceId": { "type": "string", "maxLength": 200 },
    "details": { "type": "object", "maxProperties": 20 }
  }
}
