{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/revocation-status.schema.json",
  "title": "Revocation status",
  "type": "object",
  "additionalProperties": false,
  "required": ["revocationId", "subjectType", "subjectReference", "status", "reasonCode", "effectiveAt", "issuedBy"],
  "properties": {
    "revocationId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "subjectType": { "enum": ["passport", "install_grant", "connection", "capability", "delegation", "issuer_key"] },
    "subjectReference": { "type": "string", "minLength": 1, "maxLength": 500 },
    "status": { "enum": ["active", "suspended", "revoked"] },
    "reasonCode": { "type": "string", "minLength": 1, "maxLength": 200 },
    "effectiveAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "replacementReference": { "type": "string", "maxLength": 500 },
    "issuedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
    "proof": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/proof" }
  }
}
