{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/request-challenge.schema.json",
  "title": "Signed-request nonce challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "challengeId", "connectionId", "audience", "nonce", "issuedAt", "expiresAt"],
  "properties": {
    "profile": { "const": "ghostbridge-http-signature/0.1-draft" },
    "challengeId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "connectionId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "audience": { "type": "string", "minLength": 1, "maxLength": 500 },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 500 },
    "issuedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" }
  }
}
