{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/passport.schema.json",
  "title": "Agent Passport",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "passportId", "passportVersion", "agentId", "displayName", "safeDescription", "issuer", "issuedAt", "expiresAt", "status", "capabilities", "supportedProtocolVersions", "supportedTransports", "dataDeclarations", "delegationDeclarations", "approvalDeclarations", "receiptSupport", "revocationReference"],
  "properties": {
    "protocolVersion": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/protocolVersion" },
    "passportId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "passportVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "agentId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "safeDescription": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "issuer": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "issuedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["draft", "active", "suspended", "expired", "revoked", "retired"] },
    "capabilities": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "supportedProtocolVersions": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "supportedTransports": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "profiles": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/profiles" },
    "dataDeclarations": { "type": "array", "maxItems": 100, "items": {} },
    "delegationDeclarations": { "type": "array", "maxItems": 100, "items": {} },
    "approvalDeclarations": { "type": "array", "maxItems": 100, "items": {} },
    "receiptSupport": { "type": "boolean" },
    "revocationReference": { "type": "string", "minLength": 1, "maxLength": 500 },
    "publicVerificationReference": { "type": "string", "maxLength": 500 },
    "documentationReferences": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "extensionDeclarations": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "trustProfileVersion": { "const": "ghostbridge-trust/0.1-draft" },
    "capabilityManifestDigest": { "type": "string", "minLength": 32, "maxLength": 100 },
    "authenticationDeclarations": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/stringList" },
    "authorizedAgentExecutionKeys": { "type": "array", "maxItems": 32, "items": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/agent-execution-key.schema.json" } },
    "proof": { "anyOf": [{ "$ref": "https://ghostbridge.dev/schemas/0.1-draft/proof.schema.json" }, { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/proof" }] }
  }
}
