{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/capability-manifest.schema.json",
  "title": "Signed Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "trustProfileVersion", "manifestVersion", "agentId", "passportId", "passportVersion", "capabilities", "issuedAt", "expiresAt", "status", "issuer", "proof"],
  "properties": {
    "protocolVersion": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/protocolVersion" },
    "trustProfileVersion": { "const": "ghostbridge-trust/0.1-draft" },
    "manifestVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "agentId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "passportId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "passportVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityKey", "capabilityVersion", "contractDigest"],
        "properties": {
          "capabilityKey": { "type": "string", "minLength": 1, "maxLength": 200 },
          "capabilityVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
          "contractDigest": { "type": "string", "minLength": 32, "maxLength": 100 }
        }
      }
    },
    "issuedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["active", "suspended", "revoked", "expired"] },
    "issuer": { "type": "string", "format": "uri", "maxLength": 500 },
    "proof": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/proof.schema.json" }
  }
}
