{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/execution-receipt.schema.json",
  "title": "Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "invocationId", "taskId", "agentId", "passportVersion", "capabilityKey", "capabilityVersion", "organizationScope", "outcome", "outputContractReference", "startedAt", "completedAt", "attemptCount", "outputDigest", "evidenceDigest", "revocationStateAtExecution"],
  "properties": {
    "receiptId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "invocationId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "taskId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "agentId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "passportVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "capabilityKey": { "type": "string", "minLength": 1, "maxLength": 200 },
    "capabilityVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "organizationScope": { "type": "string", "minLength": 1, "maxLength": 200 },
    "workspaceScope": { "type": "string", "maxLength": 200 },
    "outcome": { "enum": ["completed", "failed", "cancelled", "timed_out", "rejected", "revoked", "partially_completed", "compensated"] },
    "outputContractReference": { "type": "string", "minLength": 1, "maxLength": 500 },
    "startedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "completedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "attemptCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "approvalReference": { "type": "string", "maxLength": 500 },
    "delegationReference": { "type": "string", "maxLength": 500 },
    "policyDecisionReference": { "type": "string", "maxLength": 500 },
    "outputDigest": { "type": "string", "minLength": 16, "maxLength": 500 },
    "evidenceDigest": { "type": "string", "minLength": 16, "maxLength": 500 },
    "billableStatusCategory": { "type": "string", "maxLength": 100 },
    "nonBillableReason": { "type": "string", "maxLength": 500 },
    "revocationStateAtExecution": { "enum": ["active", "revoked", "unknown"] },
    "passportId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "agentExecutionKeyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$" },
    "issuer": { "type": "string", "format": "uri", "maxLength": 500 },
    "audience": { "type": "string", "minLength": 1, "maxLength": 500 },
    "issuedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "messageId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "trustProfileVersion": { "const": "ghostbridge-trust/0.1-draft" },
    "proof": { "anyOf": [{ "$ref": "https://ghostbridge.dev/schemas/0.1-draft/proof.schema.json" }, { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/proof" }] }
  }
}
