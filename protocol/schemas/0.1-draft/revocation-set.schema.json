{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/revocation-set.schema.json",
  "title": "Signed distributed issuer revocation set",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "trustProfileVersion", "revocationSetId", "issuer", "sequence", "generatedAt", "nextUpdate", "status", "previousSetDigest", "entries", "extensions", "proof"],
  "properties": {
    "protocolVersion": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/protocolVersion" },
    "trustProfileVersion": { "const": "ghostbridge-trust/0.1-draft" },
    "revocationSetId": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/opaqueId" },
    "issuer": { "type": "string", "format": "uri", "maxLength": 500 },
    "sequence": { "type": "integer", "minimum": 1 },
    "generatedAt": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "nextUpdate": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/timestamp" },
    "status": { "enum": ["active", "suspended"] },
    "previousSetDigest": { "type": "string", "minLength": 4, "maxLength": 100 },
    "entries": { "type": "array", "maxItems": 10000, "items": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/revocation-entry.schema.json" } },
    "extensions": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/extensions" },
    "proof": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/proof.schema.json" }
  }
}
