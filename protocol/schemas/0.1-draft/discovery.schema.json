{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ghostbridge.dev/schemas/0.1-draft/discovery.schema.json",
  "title": "Ghost Bridge Native discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "supportedVersions", "preferredVersion", "status", "features", "transports", "maximumMessageBytes", "endpoints", "extensionNamespaces"],
  "properties": {
    "protocol": { "const": "ghostbridge" },
    "supportedVersions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^ghostbridge/[0-9]+\\.[0-9]+(?:-[a-z0-9-]+)?$" }, "uniqueItems": true },
    "preferredVersion": { "type": "string", "maxLength": 100 },
    "status": { "enum": ["experimental", "stable", "deprecated"] },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "approvals", "delegation", "receipts", "revocation"],
      "properties": {
        "tasks": { "type": "boolean" },
        "approvals": { "type": "boolean" },
        "delegation": { "type": "boolean" },
        "receipts": { "type": "boolean" },
        "revocation": { "type": "boolean" }
      }
    },
    "transports": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 100 }, "uniqueItems": true },
    "maximumMessageBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "endpoints": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": { "type": "string", "maxLength": 500 }
    },
    "profiles": { "$ref": "https://ghostbridge.dev/schemas/0.1-draft/common.schema.json#/$defs/profiles" },
    "extensionNamespaces": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 200 }, "uniqueItems": true }
  }
}
