{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:7d66052a-8a55-4641-bd8d-8990c5db9940",
  "title": "D2-01A Semantic Constraint Inventory",
  "description": "Closed D2 traceability machinery, not a second specification or a source of wire semantics.",
  "type": "object",
  "required": [
    "inventorySchema",
    "protocolRelease",
    "status",
    "structuralValidationDefinition",
    "rawSemanticValidationDefinition",
    "notSecondSpecification",
    "constraints"
  ],
  "properties": {
    "inventorySchema": {
      "const": "urn:uuid:7d66052a-8a55-4641-bd8d-8990c5db9940"
    },
    "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
    "status": { "const": "foundation-partial" },
    "structuralValidationDefinition": { "type": "string", "minLength": 1 },
    "rawSemanticValidationDefinition": { "type": "string", "minLength": 1 },
    "notSecondSpecification": { "const": true },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/constraint" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["h", "req", "d2r"],
      "properties": {
        "h": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^H-(0[1-9]|1[0-4])$" }
        },
        "req": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{4}$" }
        },
        "d2r": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^D2R-[0-9]{3}[A-Z]?$" }
        }
      },
      "additionalProperties": false
    },
    "failureAuthority": {
      "type": "object",
      "required": ["status", "references"],
      "properties": {
        "status": { "enum": ["existing", "downstream-binding-pending"] },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": [
        "id",
        "validationLayer",
        "affected",
        "predicate",
        "structuralCoverage",
        "provenance",
        "failureAuthority",
        "downstreamOwner"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:FND|RDA)-[A-Z0-9-]+$" },
        "validationLayer": { "enum": ["RAW", "SEMANTIC", "RAW_AND_SEMANTIC"] },
        "affected": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "predicate": { "type": "string", "minLength": 1 },
        "structuralCoverage": { "enum": ["NONE", "PARTIAL"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "failureAuthority": { "$ref": "#/$defs/failureAuthority" },
        "downstreamOwner": { "type": "string", "pattern": "^D2-[0-9]{2}[A-Z]?$" },
        "executableCheck": { "type": "string", "pattern": "^RDA-SEM-[A-Z0-9-]+$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
