{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:927bbd7a-e229-440d-95f1-6ff0ebefe716",
  "title": "D2-01A Release Registry Foundation",
  "description": "Closed D2 registry machinery. Registry allocation is not negotiation or selection authority.",
  "type": "object",
  "required": [
    "registrySchema",
    "protocolRelease",
    "status",
    "registryClass",
    "facets",
    "authenticationProfiles",
    "capabilityRegistryCreated",
    "negotiationSemanticsOwnedByD1"
  ],
  "properties": {
    "registrySchema": { "const": "urn:uuid:927bbd7a-e229-440d-95f1-6ff0ebefe716" },
    "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
    "status": { "const": "draft-prerelease" },
    "registryClass": { "const": "release-owned-allocations" },
    "facets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/facet" },
      "allOf": [
        { "contains": { "$ref": "#/$defs/facetHostCore" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/facetAgentCore" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/facetTrustVerificationCore" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/facetHostGovernedExecution" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/facetAgentGovernedExecution" }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "authenticationProfiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authenticationProfile" },
      "allOf": [
        { "contains": { "$ref": "#/$defs/signedRequestPop" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/noneTestFixture" }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "capabilityRegistryCreated": { "const": false },
    "negotiationSemanticsOwnedByD1": { "const": true }
  },
  "$defs": {
    "token": { "$ref": "urn:uuid:d213d7c9-15da-41f2-b51b-286944581a74" },
    "revision": { "$ref": "urn:uuid:735bbcfb-bdd0-4c80-8c40-351ce5e5c93e" },
    "facet": {
      "type": "object",
      "required": ["id", "revision", "allocationStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "revision": { "$ref": "#/$defs/revision" },
        "allocationStatus": { "const": "allocated" }
      },
      "additionalProperties": false
    },
    "facetHostCore": {
      "type": "object",
      "required": ["id", "revision", "allocationStatus"],
      "properties": {
        "id": { "const": "gb.facet.host.core" },
        "revision": { "const": 1 },
        "allocationStatus": { "const": "allocated" }
      },
      "additionalProperties": false
    },
    "facetAgentCore": {
      "type": "object",
      "required": ["id", "revision", "allocationStatus"],
      "properties": {
        "id": { "const": "gb.facet.agent.core" },
        "revision": { "const": 1 },
        "allocationStatus": { "const": "allocated" }
      },
      "additionalProperties": false
    },
    "facetTrustVerificationCore": {
      "type": "object",
      "required": ["id", "revision", "allocationStatus"],
      "properties": {
        "id": { "const": "gb.facet.trust-verification.core" },
        "revision": { "const": 1 },
        "allocationStatus": { "const": "allocated" }
      },
      "additionalProperties": false
    },
    "facetHostGovernedExecution": {
      "type": "object",
      "required": ["id", "revision", "allocationStatus"],
      "properties": {
        "id": { "const": "gb.facet.host.governed-execution" },
        "revision": { "const": 1 },
        "allocationStatus": { "const": "allocated" }
      },
      "additionalProperties": false
    },
    "facetAgentGovernedExecution": {
      "type": "object",
      "required": ["id", "revision", "allocationStatus"],
      "properties": {
        "id": { "const": "gb.facet.agent.governed-execution" },
        "revision": { "const": 1 },
        "allocationStatus": { "const": "allocated" }
      },
      "additionalProperties": false
    },
    "securityBounds": {
      "type": "object",
      "required": [
        "credentialMaximumValiditySeconds",
        "requestProofLifetimeSeconds",
        "requestProofMaximumAgeSeconds"
      ],
      "properties": {
        "credentialMaximumValiditySeconds": { "const": 86400 },
        "requestProofLifetimeSeconds": { "const": 60 },
        "requestProofMaximumAgeSeconds": { "const": 60 }
      },
      "additionalProperties": false
    },
    "signedRequestPop": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "eligibility",
        "eligible",
        "productionDefault",
        "productionFallback",
        "securityBounds"
      ],
      "properties": {
        "id": { "const": "gb.auth.signed-request-pop" },
        "revision": { "const": 1 },
        "eligibility": { "const": "pending-complete-profile-and-d2-evidence" },
        "eligible": { "const": false },
        "productionDefault": { "const": false },
        "productionFallback": { "const": false },
        "securityBounds": { "$ref": "#/$defs/securityBounds" }
      },
      "additionalProperties": false
    },
    "noneTestFixture": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "eligibility",
        "eligible",
        "productionDefault",
        "productionFallback",
        "productionConnectionAuthority"
      ],
      "properties": {
        "id": { "const": "gb.auth.none-test-fixture" },
        "revision": { "const": 1 },
        "eligibility": { "const": "permanently-non-production-test-fixture" },
        "eligible": { "const": false },
        "productionDefault": { "const": false },
        "productionFallback": { "const": false },
        "productionConnectionAuthority": { "const": false }
      },
      "additionalProperties": false
    },
    "authenticationProfile": {
      "oneOf": [
        { "$ref": "#/$defs/signedRequestPop" },
        { "$ref": "#/$defs/noneTestFixture" }
      ]
    }
  },
  "additionalProperties": false
}
