{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:927bbd7a-e229-440d-95f1-6ff0ebefe716",
  "title": "D2-01B Atomic Release-Data Registry Manifest",
  "description": "Closed release-subordinate manifest for exactly seven exact-byte registry artifacts. Array order has no protocol meaning.",
  "type": "object",
  "required": ["manifestSchema", "protocolRelease", "status", "registryArtifacts"],
  "properties": {
    "manifestSchema": { "const": "urn:uuid:927bbd7a-e229-440d-95f1-6ff0ebefe716" },
    "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
    "status": { "const": "draft-prerelease" },
    "registryArtifacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "oneOf": [
        { "$ref": "#/$defs/sourceClaimAuthority" },
        { "$ref": "#/$defs/directionalBinding" },
        { "$ref": "#/$defs/facetProperty" },
        { "$ref": "#/$defs/coreCapabilityAllocation" },
        { "$ref": "#/$defs/externalCapabilityEligibility" },
        { "$ref": "#/$defs/globalFeatureAllocation" },
        { "$ref": "#/$defs/authenticationProfile" }
      ] },
      "allOf": [
        { "contains": { "$ref": "#/$defs/sourceClaimAuthority" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/directionalBinding" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/facetProperty" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/coreCapabilityAllocation" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/externalCapabilityEligibility" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/globalFeatureAllocation" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/authenticationProfile" }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "artifactIdentity": { "type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*\/$)[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "sourceClaimAuthority": {
      "type": "object",
      "required": ["registryClass", "protocolRelease", "artifactSchema", "path", "sourceClaimAuthorityArtifact", "artifactByteIntegrity"],
      "properties": {
        "registryClass": { "const": "gb.registry.source-claim-authority" },
        "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
        "artifactSchema": { "const": "urn:uuid:85293782-58f5-4c69-aa5b-830dd8aa480d" },
        "path": { "const": "protocol/registries/e1.r0-draft.1/release-data/source-claim-authority.registry.json" },
        "sourceClaimAuthorityArtifact": { "$ref": "#/$defs/artifactIdentity" },
        "artifactByteIntegrity": { "$ref": "urn:uuid:16534fa9-8aa1-4324-b6b9-a2a1043682f3" }
      },
      "additionalProperties": false
    },
    "directionalBinding": {
      "type": "object",
      "required": ["registryClass", "protocolRelease", "artifactSchema", "path", "directionalBindingArtifact", "artifactByteIntegrity"],
      "properties": {
        "registryClass": { "const": "gb.registry.directional-binding" },
        "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
        "artifactSchema": { "const": "urn:uuid:e47a0317-4178-4ad3-8238-4c9aadce1cb2" },
        "path": { "const": "protocol/registries/e1.r0-draft.1/release-data/directional-binding.registry.json" },
        "directionalBindingArtifact": { "$ref": "#/$defs/artifactIdentity" },
        "artifactByteIntegrity": { "$ref": "urn:uuid:16534fa9-8aa1-4324-b6b9-a2a1043682f3" }
      },
      "additionalProperties": false
    },
    "facetProperty": {
      "type": "object",
      "required": ["registryClass", "protocolRelease", "artifactSchema", "path", "facetPropertyArtifact", "artifactByteIntegrity"],
      "properties": {
        "registryClass": { "const": "gb.registry.facet-property" },
        "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
        "artifactSchema": { "const": "urn:uuid:876284f1-c7c1-468f-bab6-c679e564c3fe" },
        "path": { "const": "protocol/registries/e1.r0-draft.1/release-data/facet-property.registry.json" },
        "facetPropertyArtifact": { "$ref": "#/$defs/artifactIdentity" },
        "artifactByteIntegrity": { "$ref": "urn:uuid:16534fa9-8aa1-4324-b6b9-a2a1043682f3" }
      },
      "additionalProperties": false
    },
    "coreCapabilityAllocation": {
      "type": "object",
      "required": ["registryClass", "protocolRelease", "artifactSchema", "path", "coreCapabilityAllocationArtifact", "artifactByteIntegrity"],
      "properties": {
        "registryClass": { "const": "gb.registry.core-capability-allocation" },
        "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
        "artifactSchema": { "const": "urn:uuid:cfe70791-b8f7-48f7-809f-f7c6872c3c46" },
        "path": { "const": "protocol/registries/e1.r0-draft.1/release-data/core-capability-allocation.registry.json" },
        "coreCapabilityAllocationArtifact": { "$ref": "#/$defs/artifactIdentity" },
        "artifactByteIntegrity": { "$ref": "urn:uuid:16534fa9-8aa1-4324-b6b9-a2a1043682f3" }
      },
      "additionalProperties": false
    },
    "externalCapabilityEligibility": {
      "type": "object",
      "required": ["registryClass", "protocolRelease", "artifactSchema", "path", "externalCapabilityEligibilityArtifact", "artifactByteIntegrity"],
      "properties": {
        "registryClass": { "const": "gb.registry.external-capability-eligibility" },
        "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
        "artifactSchema": { "const": "urn:uuid:f901bb9f-46b5-4b04-a2cd-4185e43f560e" },
        "path": { "const": "protocol/registries/e1.r0-draft.1/release-data/external-capability-eligibility.registry.json" },
        "externalCapabilityEligibilityArtifact": { "$ref": "#/$defs/artifactIdentity" },
        "artifactByteIntegrity": { "$ref": "urn:uuid:16534fa9-8aa1-4324-b6b9-a2a1043682f3" }
      },
      "additionalProperties": false
    },
    "globalFeatureAllocation": {
      "type": "object",
      "required": ["registryClass", "protocolRelease", "artifactSchema", "path", "globalFeatureAllocationArtifact", "artifactByteIntegrity"],
      "properties": {
        "registryClass": { "const": "gb.registry.global-feature-allocation" },
        "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
        "artifactSchema": { "const": "urn:uuid:001a31f0-2190-43f8-988d-8d3055450d28" },
        "path": { "const": "protocol/registries/e1.r0-draft.1/release-data/global-feature-allocation.registry.json" },
        "globalFeatureAllocationArtifact": { "$ref": "#/$defs/artifactIdentity" },
        "artifactByteIntegrity": { "$ref": "urn:uuid:16534fa9-8aa1-4324-b6b9-a2a1043682f3" }
      },
      "additionalProperties": false
    },
    "authenticationProfile": {
      "type": "object",
      "required": ["registryClass", "protocolRelease", "artifactSchema", "path", "authenticationProfileArtifact", "artifactByteIntegrity"],
      "properties": {
        "registryClass": { "const": "gb.registry.authentication-profile" },
        "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
        "artifactSchema": { "const": "urn:uuid:9feb2499-b6f5-4b4b-875a-d6b65b861e3c" },
        "path": { "const": "protocol/registries/e1.r0-draft.1/release-data/authentication-profile.registry.json" },
        "authenticationProfileArtifact": { "$ref": "#/$defs/artifactIdentity" },
        "artifactByteIntegrity": { "$ref": "urn:uuid:16534fa9-8aa1-4324-b6b9-a2a1043682f3" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
