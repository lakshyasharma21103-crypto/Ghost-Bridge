{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:19b7f64a-9159-4a07-ac71-7404a64546e3",
  "title": "D2-01R1 Revision 2 Lossless Raw-Input Fixture Corpus",
  "description": "Lowercase hexadecimal lossless byte carriers evaluated without JSON parse/reserialize of the carried source.",
  "type": "object",
  "required": ["fixtureSchema", "protocolRelease", "encoding", "cases"],
  "properties": {
    "fixtureSchema": { "const": "urn:uuid:19b7f64a-9159-4a07-ac71-7404a64546e3" },
    "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
    "encoding": { "const": "lossless-lowercase-hex-segments-v1" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rawCase" } }
  },
  "$defs": {
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["hex"],
          "properties": {
            "hex": { "type": "string", "maxLength": 4194304, "pattern": "^(?:[0-9a-f]{2})*$" },
            "repeat": { "type": "integer", "minimum": 1, "maximum": 2097152 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["segments"],
          "properties": {
            "segments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 512,
              "items": { "$ref": "#/$defs/segment" }
            },
            "repeat": { "type": "integer", "minimum": 1, "maximum": 2097152 }
          },
          "additionalProperties": false
        }
      ]
    },
    "rawCase": {
      "type": "object",
      "required": ["id", "source", "maximumBytes", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^R1-RAW-[A-Z0-9-]+$" },
        "source": { "$ref": "#/$defs/segment" },
        "maximumBytes": { "type": "integer", "minimum": 0, "maximum": 2097152 },
        "expected": { "enum": ["pass", "fail"] },
        "expectedDiagnostic": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "expectedTokenCount": { "type": "integer", "minimum": 0, "maximum": 16384 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
