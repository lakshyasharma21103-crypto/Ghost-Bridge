{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:da99d351-12ed-42b8-8ddd-9fc761e638f0",
  "title": "D2-01 Foundation and Shared Fixture Corpus",
  "description": "Closed D2 validation-fixture machinery. These are foundation and shared-canonical-vocabulary cases, not conformance fixtures or cryptographic golden vectors.",
  "type": "object",
  "required": ["fixtureSchema", "protocolRelease", "classification", "cases"],
  "properties": {
    "fixtureSchema": { "const": "urn:uuid:da99d351-12ed-42b8-8ddd-9fc761e638f0" },
    "protocolRelease": { "const": "ghostbridge/e1.r0-draft.1" },
    "classification": {
      "enum": [
        "structural-positive",
        "structural-negative",
        "semantic-positive",
        "semantic-negative",
        "boundary"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "uuidUrn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "valueCase": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "targetSchema",
        "value",
        "structuralExpected",
        "semanticExpected",
        "semanticCheck"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^FX-[A-Z0-9-]+$" },
        "kind": { "const": "value" },
        "targetSchema": { "$ref": "#/$defs/uuidUrn" },
        "value": true,
        "semanticInput": { "$ref": "#/$defs/artifactSemanticInput" },
        "structuralExpected": { "enum": ["pass", "fail"] },
        "semanticExpected": { "enum": ["pass", "fail", "not-applicable"] },
        "semanticCheck": {
          "enum": [
            "none",
            "tenant-id",
            "canonical-base64url",
            "canonical-timestamp",
            "time-evidence",
            "origin-syntax",
            "artifact-byte-integrity",
            "extension-identity"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifactSemanticInput": {
      "description": "Closed non-wire input used only by deterministic semantic-validator evidence.",
      "type": "object",
      "required": ["artifactBytesHex"],
      "properties": {
        "artifactBytesHex": { "type": "string", "maxLength": 2097152 }
      },
      "additionalProperties": false
    },
    "equalityCase": {
      "type": "object",
      "required": ["id", "kind", "targetSchema", "values", "equalExpected", "semanticCheck"],
      "properties": {
        "id": { "type": "string", "pattern": "^FX-[A-Z0-9-]+$" },
        "kind": { "const": "equality" },
        "targetSchema": { "$ref": "#/$defs/uuidUrn" },
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "equalExpected": { "type": "boolean" },
        "semanticCheck": { "const": "tenant-exact-equality" }
      },
      "additionalProperties": false
    },
    "rawSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["encoding", "value"],
          "properties": {
            "encoding": { "const": "utf8" },
            "value": { "type": "string", "maxLength": 1048576 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["encoding", "value"],
          "properties": {
            "encoding": { "const": "hex" },
            "value": { "type": "string", "maxLength": 2097152, "pattern": "^(?:[0-9A-Fa-f]{2})*$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["encoding", "prefix", "value", "count", "suffix"],
          "properties": {
            "encoding": { "const": "repeat-utf8" },
            "prefix": { "type": "string", "maxLength": 1024 },
            "value": { "type": "string", "maxLength": 1024 },
            "count": { "type": "integer", "minimum": 0, "maximum": 1048576 },
            "suffix": { "type": "string", "maxLength": 1024 }
          },
          "additionalProperties": false
        }
      ]
    },
    "rawNumberToken": {
      "type": "object",
      "required": ["path", "token", "mathematicalInteger"],
      "properties": {
        "path": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [
              { "type": "string", "maxLength": 65536 },
              { "type": "integer", "minimum": 0, "maximum": 255 }
            ]
          }
        },
        "token": { "type": "string", "maxLength": 1024 },
        "mathematicalInteger": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "rawCase": {
      "type": "object",
      "required": ["id", "kind", "wireClass", "source", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^FX-[A-Z0-9-]+$" },
        "kind": { "const": "raw-json" },
        "wireClass": { "enum": ["request", "response", "error-response"] },
        "source": { "$ref": "#/$defs/rawSource" },
        "expected": { "enum": ["pass", "fail"] },
        "diagnosticIncludes": { "type": "string", "minLength": 1, "maxLength": 120 },
        "expectedNumberTokens": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/rawNumberToken" }
        }
      },
      "additionalProperties": false
    },
    "case": {
      "oneOf": [
        { "$ref": "#/$defs/valueCase" },
        { "$ref": "#/$defs/equalityCase" },
        { "$ref": "#/$defs/rawCase" }
      ]
    }
  },
  "additionalProperties": false
}
