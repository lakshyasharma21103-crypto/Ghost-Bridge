{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:0e6ccf5f-fbef-41eb-a4b8-dbe1c895d381",
  "title": "Origin",
  "description": "Closed structured origin representation. Structural recognition, including http, grants no contextual transport authority.",
  "type": "object",
  "required": ["scheme", "host", "port"],
  "properties": {
    "scheme": { "enum": ["http", "https"] },
    "host": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "dns" },
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "ipv4" },
            "value": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,2})(?:\\.(?:0|[1-9][0-9]{0,2})){3}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "ipv6" },
            "value": {
              "type": "string",
              "minLength": 2,
              "maxLength": 39,
              "pattern": "^[0-9a-f:]+$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "additionalProperties": false
}
