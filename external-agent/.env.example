PORT=5002
NODE_ENV=development
EXTERNAL_AGENT_RUNTIME_TOKEN=<external-agent-runtime-token>
ALLOWED_GATEWAY_ORIGINS=
REQUEST_TIMEOUT_MS=600000
SHUTDOWN_DRAIN_TIMEOUT_MS=30000
AI_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=<gemini-model-id>
GEMINI_WEB_SEARCH_ENABLED=true
GEMINI_RESEARCH_TIMEOUT_MS=120000
GEMINI_RESEARCH_FALLBACK_TIMEOUT_MS=180000
GEMINI_FORMATTING_TIMEOUT_MS=60000
GEMINI_RESEARCH_MAX_ATTEMPTS=2
GEMINI_FORMATTING_MAX_ATTEMPTS=2
GEMINI_RESEARCH_MAX_OUTPUT_TOKENS=512
GEMINI_RESEARCH_FALLBACK_MAX_OUTPUT_TOKENS=256
GEMINI_FORMATTING_MAX_OUTPUT_TOKENS=1500
GEMINI_MAX_SOURCES=8
EXTERNAL_AGENT_VERIFY_BASE_URL=https://<external-agent-host>
EXTERNAL_AGENT_VERIFY_TIMEOUT_MS=660000
EXTERNAL_TEST_AGENT_BASE_URL=https://<external-agent-host>
